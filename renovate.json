{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>crstian19/.github:renovate-config",
    ":semanticCommits"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Group the Charm libraries: they move together.",
      "matchPackageNames": [
        "charm.land/**",
        "github.com/charmbracelet/**"
      ],
      "groupName": "charm"
    },
    {
      "description": "Patch updates for the standard library and tooling need no review.",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
