# Bearer token from dashcam.tesla.com.
# DevTools -> Network -> any /api/1/ request -> Authorization: Bearer <token>
# Tokens expire, so refresh this each session. Never commit the real .env.
TESLA_TOKEN=

# Only for testing against a stub server; leave unset to use dashcam.tesla.com.
# TESLA_API_BASE=http://127.0.0.1:8080
